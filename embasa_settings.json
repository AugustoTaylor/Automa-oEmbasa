{
  "app": {
    "name": "EMBASA",
    "version": "1.8.12",
    "company_code": "EMBA"
  },
  "startup": {
    "require_sap_session": false
  },
  "auth": {
    "enabled": true,
    "shared_dir": "dados_compartilhados/autenticacao",
    "db_file": "usuarios.json"
  },
  "saldo_contas": {
    "shared_dir": "dados_compartilhados/saldo_contas",
    "models_file": "modelos.json"
  },
  "timing": {
    "action_delay_seconds": 0,
    "max_action_delay_seconds": 30
  },
  "security": {
    "mask_documents_in_logs": true
  },
  "cache": {
    "enabled": true,
    "persist_to_disk": true,
    "ttl_days": 30,
    "max_entries": 2000,
    "file_name": "cliente_cache.json",
    "shared_dir": "dados_compartilhados/cache",
    "fallback_to_local": true,
    "reload_on_read": true,
    "lock_timeout_seconds": 3
  },
  "history": {
    "enabled": true,
    "shared_dir": "dados_compartilhados/historico",
    "db_file": "historico_pedidos.json",
    "max_entries": 5000,
    "max_results": 200,
    "fallback_to_local": true,
    "lock_timeout_seconds": 5
  },
  "drafts": {
    "enabled": true,
    "shared_dir": "dados_compartilhados/rascunhos",
    "client_db_file": "rascunhos_clientes.json",
    "max_entries": 500,
    "max_results": 100,
    "fallback_to_local": true,
    "lock_timeout_seconds": 5
  },
  "support": {
    "notification_email_enabled": true,
    "delivery_mode": "smtp_direct",
    "smtp_host": "embasa.in.tmes.trendmicro.com",
    "smtp_port": 25,
    "smtp_use_tls": true,
    "smtp_username": "",
    "smtp_password_env": "EMBASA_SUPPORT_SMTP_PASSWORD",
    "smtp_from_email": "automacao-api@embasa.ba.gov.br",
    "smtp_from_name": "EMBASA - Fale Conosco",
    "subject_prefix": "[EMBASA - Fale Conosco]"
  },
  "f110": {
    "shared_dir": "dados_compartilhados/f110",
    "bol_memory_file": "ultimo_bol.json",
    "fallback_to_local": true,
    "lock_timeout_seconds": 180,
    "reservation_ttl_seconds": 600
  }
}
